# SiteLens — environment template. Copy to .env and fill in.
# Secrets NEVER enter code, migrations, chat, or git (CLAUDE.md SECURITY).
# Local and cloud differ ONLY in these values.

# ── Supabase (local defaults come from `supabase status`) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=

# ── AC-6 test runner (populated from `supabase status`) ──
API_URL=http://127.0.0.1:54321
ANON_KEY=
JWT_SECRET=

# ── Object storage (local: Supabase Storage; prod: Cloudflare R2) ──
STORAGE_PROVIDER=supabase          # supabase | r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Auth / OTP (local: dev shim; prod: Termii) ──
OTP_PROVIDER=dev                   # dev | termii
TERMII_API_KEY=

# ── AI router (OpenRouter); DEV_AI_MODE returns stubs, no key needed ──
DEV_AI_MODE=true
OPENROUTER_API_KEY=

# ── Notifications (dev writes to dev_outbox / console) ──
NOTIFY_MODE=dev                    # dev | live
WHATSAPP_API_KEY=
RESEND_API_KEY=
